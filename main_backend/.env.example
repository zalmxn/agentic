# Main FastAPI Backend Configuration (SQLite)
DATABASE_URL=sqlite:///./booking_platform.db
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
INTERNAL_API_TOKEN=change-this-to-a-shared-internal-service-token
AI_SERVICE_URL=http://127.0.0.1:8001
AI_REQUEST_TIMEOUT=15.0
DEFAULT_TIMEZONE=Asia/Kolkata
AUTO_SEED_DEMO_DATA=true
LOG_LEVEL=INFO
